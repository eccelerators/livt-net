namespace Livt.Net

/**
 * Checked request recognition and prepared reply composition. One serialized
 * owner must finish all reads/TX borrows before preparing or invalidating again.
 * Preparation snapshots request metadata and echo data; emission does not read the request.
 */
component IcmpEchoResponder<S: IPacketData, FRAME_CAPACITY: int = 128> : IPacketData
{
	static assert FRAME_CAPACITY >= 42, "Frame capacity must hold the required protocol header"

	// Borrowed shared parsers; consumers must serialize their use.
	ethernet: EthernetFrameParser<S>
	ipv4: Ipv4PacketParser<EthernetFrameParser<S>>

	// Owned RAM snapshot of echo data, retained throughout reply emission.
	data: RamPacketData<FRAME_CAPACITY>

	// Owned nested reply envelopes borrowing the snapshot and each other.
	reply: IcmpEchoReply<RamPacketData<FRAME_CAPACITY>>
	ip: IcmpEchoReplyPacket<RamPacketData<FRAME_CAPACITY>>
	frame: IcmpEchoReplyFrame<RamPacketData<FRAME_CAPACITY>, FRAME_CAPACITY>

	/**
	 * Borrows the shared Ethernet/IPv4 pair and owns RAM echo storage and reply
	 * envelopes. Parsers must describe the same capture and have one serialized owner.
	 */
	new(ethernet: EthernetFrameParser<S>, ipv4: Ipv4PacketParser<EthernetFrameParser<S>>)
	{
		this.ethernet = ethernet
		this.ipv4 = ipv4
		data = new RamPacketData<FRAME_CAPACITY>()
		reply = new IcmpEchoReply<RamPacketData<FRAME_CAPACITY>>(data)
		ip = new IcmpEchoReplyPacket<RamPacketData<FRAME_CAPACITY>>(reply)
		frame = new IcmpEchoReplyFrame<RamPacketData<FRAME_CAPACITY>, FRAME_CAPACITY>(ip)
	}

	/**
	 * Discards parser and reply metadata and releases the echo snapshot.
	 * Call only after all response readers and transmit borrows have finished.
	 */
	public fn Invalidate()
	{
		ipv4.Invalidate()
		ethernet.Invalidate()
		this.ClearResponse()
	}

	/** Releases only owned response state; preserves the shared request views. */
	fn ClearResponse()
	{
		frame.Invalidate()
		ip.Invalidate()
		reply.Invalidate()

		if (data.IsReady()) {
			data.TryRelease()
		}
		else {
			data.TryClear()
		}
	}

	/**
	 * Snapshots a complete captured echo request; receive checksums remain unchecked.
	 */
	public fn TryPrepare(localMac: byte[6], localIp: byte[4]) PacketDataResult
	{
		this.Invalidate()
		ethernet.TryParse()

		if (!ethernet.IsReady() || ethernet.GetEtherType() != IEthernetPayload.ETHER_TYPE_IPV4) {
			return PacketDataResult.Invalid
		}

		if (ipv4.TryParse() != PacketParseResult.Success) {
			return PacketDataResult.Invalid
		}

		return this.TryPrepareParsed(localMac, localIp)
	}

	/**
	 * Snapshots a complete echo request from shared, already validated parsers.
	 * Requires exclusive parser use. HeaderOnly input is rejected as before.
	 */
	public fn TryPrepareParsed(localMac: byte[6], localIp: byte[4]) PacketDataResult
	{
		this.ClearResponse()

		if (!ethernet.IsReady() || ethernet.GetEtherType() != IEthernetPayload.ETHER_TYPE_IPV4
			|| ipv4.GetStatus() != PacketParseResult.Success) {
			return PacketDataResult.Invalid
		}

		if (ipv4.GetProtocol() != IIpv4Payload.PROTOCOL_ICMP || ipv4.GetAvailableLength() < 8) {
			return PacketDataResult.Invalid
		}

		var destination = ipv4.GetDestinationIpv4()

		for (var i = 0; i < 4; i++) {
			if (destination[i] != localIp[i]) {
				return PacketDataResult.Invalid
			}
		}

		var echo: byte[8]

		for (var i = 0; i < 8; i++) {
			var value: byte = 0x00

			if (ipv4.TryRead(i, value) != PacketDataResult.Success) {
				return PacketDataResult.Invalid
			}

			echo[i] = value
		}

		if (echo[0] != 8 || echo[1] != 0) {
			return PacketDataResult.Invalid
		}

		var peerMac = ethernet.GetSourceMac()
		var peerIp = ipv4.GetSourceIpv4()
		var id = ipv4.GetIdentification()
		var identification: byte[2] = [(id / 256) as byte, (id % 256) as byte]
		var identifier: byte[2] = [echo[4], echo[5]]
		var sequence: byte[2] = [echo[6], echo[7]]
		var length = ipv4.GetAvailableLength() - 8

		for (var i = 0; i < length; i++) {
			var value: byte = 0x00

			if (ipv4.TryRead(8 + i, value) != PacketDataResult.Success || data.TryWrite(i, value) != PacketDataResult.Success) {
				this.Invalidate()
				return PacketDataResult.Invalid
			}
		}

		ipv4.Invalidate()
		ethernet.Invalidate()
		data.TryPublish()
		var result = reply.TryPrepare(identifier, sequence)

		if (result == PacketDataResult.Success) {
			result = ip.TryPrepare(localIp, peerIp, identification)
		}

		if (result == PacketDataResult.Success) {
			result = frame.TryPrepare(localMac, peerMac)
		}

		if (result != PacketDataResult.Success) {
			this.Invalidate()
		}

		return result
	}

	/**
	 * Reports whether the composed reply is prepared.
	 */
	override fn IsReady() bool
	{
		return frame.IsReady()
	}

	/**
	 * Returns the prepared Ethernet frame length including padding, or zero when unavailable.
	 */
	override fn GetAvailableLength() int
	{
		return frame.GetAvailableLength()
	}

	/**
	 * Reads a frame-relative byte from the prepared reply. Propagates the envelope
	 * result; output is valid only on Success. Finish all reads before invalidation.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		return frame.TryRead(index, value)
	}
}
