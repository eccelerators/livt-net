namespace Livt.Net

/**
 * Checked request recognition and prepared reply composition. One serialized
 * owner must finish all reads/TX borrows before preparing or invalidating again.
 * Preparation snapshots request metadata; emission does not read the request.
 */
component ArpResponder<FRAME_CAPACITY: int = 64> : IPacketData
{
	static assert FRAME_CAPACITY >= 42, "Frame capacity must hold the required protocol header"
	parser: ArpPacketParser<FRAME_CAPACITY>
	reply: ArpReply
	frame: EthernetFrame<ArpReply>
	new()
	{
		parser = new ArpPacketParser<FRAME_CAPACITY>()
		reply = new ArpReply()
		frame = new EthernetFrame<ArpReply>(reply)
	}
	public fn Invalidate() { frame.Invalidate(); reply.Invalidate() }
	public fn ShouldRespond(frame: byte[FRAME_CAPACITY], localIp: byte[4]) bool
	{
		return this.ShouldRespond(frame, localIp, FRAME_CAPACITY)
	}

	/** Checks a caller-supplied valid prefix length before reading header bytes. */
	public fn ShouldRespond(frame: byte[FRAME_CAPACITY], localIp: byte[4], validLength: int) bool
	{
		if (validLength < 42 || validLength > FRAME_CAPACITY) { return false }
		return this.parser.IsRequestForIpv4(frame, localIp[0], localIp[1], localIp[2], localIp[3])
	}

	/** One admitted preparation invalidates the prior response even on failure. */
	public fn TryPrepare(request: byte[FRAME_CAPACITY], localMac: byte[6], localIp: byte[4], validLength: int) PacketDataResult
	{
		this.Invalidate()
		if (!this.ShouldRespond(request, localIp, validLength)) { return PacketDataResult.Invalid }
		var peerMac: byte[6]
		var peerIp: byte[4]
		for (var i = 0; i < 6; i++) { peerMac[i] = request[22 + i] }
		for (var i = 0; i < 4; i++) { peerIp[i] = request[28 + i] }
		var result = reply.TryPrepare(localMac, localIp, peerMac, peerIp)
		if (result != PacketDataResult.Success) { return result }
		return frame.TryPrepare(localMac, peerMac)
	}
	override fn IsReady() bool { return frame.IsReady() }
	override fn GetAvailableLength() int { return frame.GetAvailableLength() }
	override fn TryRead(index: int, value: out byte) PacketDataResult { return frame.TryRead(index, value) }
}
