namespace Livt.Net

/**
 * Prepares an ARP reply from a bound frame provider; response addresses are snapshots.
 */
component ArpResponder<S: IPacketData> : IPacketData
{
	// Owned parsers borrowing the request source in protocol order.
	ethernet: EthernetFrameParser<S>
	parser: ArpPacketParser<EthernetFrameParser<S>>

	// Owned reply snapshot and its Ethernet envelope.
	reply: ArpReply
	frame: EthernetFrame<ArpReply>

	/**
	 * Wires recognition and reply composition without reading the source.
	 */
	new(source: S)
	{
		ethernet = new EthernetFrameParser<S>(source)
		parser = new ArpPacketParser<EthernetFrameParser<S>>(ethernet)
		reply = new ArpReply()
		frame = new EthernetFrame<ArpReply>(reply)
	}

	/**
	 * Invalidates response and input views after outstanding response borrows finish.
	 */
	public fn Invalidate()
	{
		frame.Invalidate()
		reply.Invalidate()
		parser.Invalidate()
		ethernet.Invalidate()
	}

	/**
	 * Replaces the prior response even on rejection; requires Ethernet/IPv4 ARP for the local IP.
	 */
	public fn TryPrepare(localMac: byte[6], localIp: byte[4]) PacketDataResult
	{
		this.Invalidate()
		ethernet.TryParse()

		if (!ethernet.IsReady() || ethernet.GetEtherType() != 2054) {
			return PacketDataResult.Invalid
		}

		if (parser.TryParse() != PacketParseResult.Success) {
			return PacketDataResult.Invalid
		}

		if (parser.GetOperation() != 1) {
			return PacketDataResult.Invalid
		}

		var destination = parser.GetTargetIpv4()

		for (var i = 0; i < 4; i++) {
			if (destination[i] != localIp[i]) {
				return PacketDataResult.Invalid
			}
		}

		var peerMac = parser.GetSenderMac()
		var peerIp = parser.GetSenderIpv4()
		parser.Invalidate()
		ethernet.Invalidate()
		var result = reply.TryPrepare(localMac, localIp, peerMac, peerIp)

		if (result != PacketDataResult.Success) {
			return result
		}

		return frame.TryPrepare(localMac, peerMac)
	}

	/**
	 * Reports prepared reply availability.
	 */
	override fn IsReady() bool
	{
		return frame.IsReady()
	}

	/**
	 * Returns the complete padded reply length.
	 */
	override fn GetAvailableLength() int
	{
		return frame.GetAvailableLength()
	}

	/**
	 * Reads a prepared reply byte; request storage is no longer needed.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		return frame.TryRead(index, value)
	}
}
