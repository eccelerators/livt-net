namespace Livt.Net

/**
 * Parses fixed, unfragmented IPv4 headers and bounds payload by total length.
 * Options and fragmentation are Unsupported. Success means declared bytes are
 * captured; checksum verification is a separate explicit query.
 * Bind a protocol-relative provider. Invalidate children before this parser, then
 * release the source. Metadata is cached only for the current parse lifetime.
 */
component Ipv4PacketParser<S: IPacketData> : IPacketData
{
	public const HEADER_LENGTH: int = 20
	header: PacketHeader<S, HEADER_LENGTH>
	status: PacketParseResult

	/**
	 * Binds the protocol input; construction performs no reads.
	 */
	new(source: S)
	{
		header = new PacketHeader<S, HEADER_LENGTH>(source)
	}

	/**
	 * Discards validated metadata and closes the borrowed payload view.
	 */
	public fn Invalidate()
	{
		status = PacketParseResult.NotReady
		header.Invalidate()
	}

	/**
	 * Parses once and replaces prior state even on failure. Checks structure,
	 * not endpoint policy or transport checksums.
	 */
	public fn TryParse() PacketParseResult
	{
		status = header.TryLoad()

		if (status != PacketParseResult.Success) { return status }

		var versionAndLength = header.GetByte(0)
		var version = (versionAndLength as int) / 16
		var ihl = (versionAndLength as int) % 16
		var total = header.GetWord(2)

		if (version != 4) {
			status = PacketParseResult.Unsupported
			return status
		}

		if (ihl < 5 || total < ihl * 4) {
			status = PacketParseResult.Invalid
			return status
		}

		var fragment = header.GetWord(6)

		if (ihl != 5 || (fragment != 0 && fragment != 16384)) {
			status = PacketParseResult.Unsupported
			return status
		}

		var captured = header.GetCapturedLength()
		var bounded = total

		if (bounded > captured) { bounded = captured }

		status = header.TryOpenPayload(HEADER_LENGTH, bounded - HEADER_LENGTH)

		if (status == PacketParseResult.Success && captured < total) { status = PacketParseResult.HeaderOnly }
		return status
	}

	/**
	 * Returns current validation state; unavailable sources invalidate access.
	 */
	public fn GetStatus() PacketParseResult
	{
		if ((status == PacketParseResult.Success || status == PacketParseResult.HeaderOnly) && !header.IsReady()) { return PacketParseResult.NotReady }

		return status
	}

	/**
	 * Reports available supported metadata, including partial captures.
	 */
	override fn IsReady() bool
	{
		return (status == PacketParseResult.Success || status == PacketParseResult.HeaderOnly) && header.IsReady()
	}

	/**
	 * Returns bounded captured payload bytes, not declared or wire length.
	 */
	override fn GetAvailableLength() int
	{
		if (!this.IsReady()) { return 0 }

		return header.GetAvailableLength()
	}

	/**
	 * Reads the borrowed payload relative to this protocol's header.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (!this.IsReady()) { return PacketDataResult.NotReady }

		var readValue: byte = 0x00
		var result = header.TryRead(index, readValue)
		value = readValue
		return result
	}

	/**
	 * Returns TotalLength from the supported cached header; unavailable metadata returns 0.
	 */
	public fn GetTotalLength() int
	{
		if (!this.IsReady()) { return 0 }

		return header.GetWord(2)
	}

	/**
	 * Returns Identification from the supported cached header; unavailable metadata returns 0.
	 */
	public fn GetIdentification() int
	{
		if (!this.IsReady()) { return 0 }

		return header.GetWord(4)
	}

	/**
	 * Returns Protocol from the supported cached header; unavailable metadata returns 0.
	 */
	public fn GetProtocol() byte
	{
		if (!this.IsReady()) { return 0 }

		return header.GetByte(9)
	}

	/**
	 * Returns DeclaredPayloadLength from the supported cached header; unavailable metadata returns 0.
	 */
	public fn GetDeclaredPayloadLength() int
	{
		if (!this.IsReady()) { return 0 }

		return header.GetWord(2) - HEADER_LENGTH
	}

	/**
	 * Copies the cached SourceIpv4 value; unavailable metadata returns zero bytes.
	 */
	public fn GetSourceIpv4() byte[4]
	{
		var value: byte[4]

		for (var i = 0; i < 4; i++) {
			value[i] = 0x00

			if (this.IsReady()) { value[i] = header.GetByte(12 + i) }
		}

		return value
	}

	/**
	 * Copies the cached DestinationIpv4 value; unavailable metadata returns zero bytes.
	 */
	public fn GetDestinationIpv4() byte[4]
	{
		var value: byte[4]

		for (var i = 0; i < 4; i++) {
			value[i] = 0x00

			if (this.IsReady()) { value[i] = header.GetByte(16 + i) }
		}

		return value
	}

	/**
	 * Checks the cached IPv4 header checksum only. Parsing does not enforce it,
	 * preserving the endpoint's existing unchecked receive-checksum policy.
	 */
	public fn IsHeaderChecksumValid() bool
	{
		if (!this.IsReady()) { return false }

		var sum: int = 0

		for (var i = 0; i < HEADER_LENGTH; i = i + 2) {
			sum = sum + header.GetWord(i)
		}

		sum = sum % 65536 + sum / 65536
		sum = sum % 65536 + sum / 65536
		return sum == 65535
	}
}
