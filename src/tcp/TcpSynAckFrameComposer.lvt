namespace Livt.Net

/**
 * RFC 9293 — Transmission Control Protocol (TCP) (section 3.5, Connection Establishment)
 * https://www.rfc-editor.org/rfc/rfc9293
 *
 * Composes a minimum-sized Ethernet/IPv4/TCP SYN-ACK response frame byte by byte.
 * The caller supplies a validated fixed-header request and retains its bytes and
 * response metadata throughout emission. This encoder does not validate requests.
 */
component TcpSynAckFrameComposer<FRAME_CAPACITY: int = 128>
{
	static assert FRAME_CAPACITY >= 54, "Frame capacity must hold the required protocol header"

	// Number of bytes in the composed SYN-ACK frame, padded to Ethernet minimum.
	public const FRAME_LENGTH: int = 60

	// IPv4 total length for a bare TCP SYN-ACK (20 IP + 20 TCP = 40).
	public const IPV4_TOTAL_LENGTH: int = 40

	// TCP SYN-ACK flags byte.
	public const TCP_FLAGS_SYN_ACK: byte = 0x12

	/**
	 * Returns one byte of the SYN-ACK frame; out-of-frame indices return zero.
	 * Scheduled call with no fixed-cycle guarantee; no preparation state is retained.
	 * Bytes 0–13: Ethernet II reply header.
	 * Bytes 14–33: IPv4 header (total-length=40, proto=TCP, src=localIp, dst=request src IP).
	 * Bytes 34–53: TCP header (src/dst port swapped, SYN-ACK flags, seq/ack/window/checksum).
	 * Bytes 54–59: zero padding to Ethernet minimum frame size.
	 */
	public fn GetFrameByte(
		request: byte[FRAME_CAPACITY],
		index: int,
		localMac: byte[6],
		localIp: byte[4],
		ipv4Checksum: byte[2],
		ourSeq: byte[4],
		ackNum: byte[4],
		window: byte[2],
		tcpChecksum: byte[2]) byte
	{
		if (index < 0) {
			return 0x00
		}

		if (index < 14) {
			var destinationMac: byte[6] = [request[6], request[7], request[8], request[9], request[10], request[11]]
			return EthernetFrameBuilder.GetByte(index, localMac, destinationMac, IEthernetPayload.ETHER_TYPE_IPV4)
		}

		if (index < 34) {
			if (index == 24) {
				return ipv4Checksum[0]
			}

			if (index == 25) {
				return ipv4Checksum[1]
			}

			var destinationIp: byte[4] = [request[26], request[27], request[28], request[29]]
			return Ipv4HeaderBuilder.GetByte(index - 14, IPV4_TOTAL_LENGTH, [0x00, 0x02], localIp, destinationIp, IIpv4Payload.PROTOCOL_TCP, 0)
		}

		if (index < 54) {
			var sourcePort: byte[2] = [request[36], request[37]]
			var destinationPort: byte[2] = [request[34], request[35]]
			return TcpSegmentBuilder.GetByte(index - 34, sourcePort, destinationPort, ourSeq, ackNum, TCP_FLAGS_SYN_ACK, window, tcpChecksum)
		}

		return 0x00
	}
}
