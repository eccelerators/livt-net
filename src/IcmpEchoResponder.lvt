namespace Livt.Net

/**
 * Checked request recognition and prepared reply composition. One serialized
 * owner must finish all reads/TX borrows before preparing or invalidating again.
 * Preparation snapshots request metadata and echo data; emission does not read the request.
 */
component IcmpEchoResponder<S: IPacketData, FRAME_CAPACITY: int = 128> : IPacketData
{
	static assert FRAME_CAPACITY >= 42, "Frame capacity must hold the required protocol header"
	ethernet: EthernetFrameParser<S>
	ipv4: Ipv4PacketParser<EthernetFrameParser<S>>
	data: ArrayPacketData<FRAME_CAPACITY>
	reply: IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>
	ip: Ipv4Packet<IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>>
	frame: EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>>, FRAME_CAPACITY>
	new(source: S)
	{
		ethernet = new EthernetFrameParser<S>(source)
		ipv4 = new Ipv4PacketParser<EthernetFrameParser<S>>(ethernet)
		data = new ArrayPacketData<FRAME_CAPACITY>()
		reply = new IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>(data)
		ip = new Ipv4Packet<IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>>(reply)
		frame = new EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<FRAME_CAPACITY>>>, FRAME_CAPACITY>(ip)
	}
	public fn Invalidate()
	{
		ipv4.Invalidate()
		ethernet.Invalidate()
		frame.Invalidate()
		ip.Invalidate()
		reply.Invalidate()
		if (data.IsReady()) { data.TryRelease() }
		else { data.TryClear() }
	}

	/**
	 * Snapshots a complete captured echo request; receive checksums remain unchecked.
	 */
	public fn TryPrepare(localMac: byte[6], localIp: byte[4]) PacketDataResult
	{
		this.Invalidate()
		ethernet.TryParse()

		if (!ethernet.IsReady() || ethernet.GetEtherType() != 2048) { return PacketDataResult.Invalid }
		if (ipv4.TryParse() != PacketParseResult.Success) { return PacketDataResult.Invalid }
		if (ipv4.GetProtocol() != 1 || ipv4.GetAvailableLength() < 8) { return PacketDataResult.Invalid }

		var destination = ipv4.GetDestinationIpv4()

		for (var i = 0; i < 4; i++) {
			if (destination[i] != localIp[i]) { return PacketDataResult.Invalid }
		}

		var echo: byte[8]

		for (var i = 0; i < 8; i++) {
			var value: byte = 0x00

			if (ipv4.TryRead(i, value) != PacketDataResult.Success) { return PacketDataResult.Invalid }

			echo[i] = value
		}

		if (echo[0] != 8 || echo[1] != 0) { return PacketDataResult.Invalid }

		var peerMac = ethernet.GetSourceMac()
		var peerIp = ipv4.GetSourceIpv4()
		var id = ipv4.GetIdentification()
		var identification: byte[2] = [(id / 256) as byte, (id % 256) as byte]
		var identifier: byte[2] = [echo[4], echo[5]]
		var sequence: byte[2] = [echo[6], echo[7]]
		var length = ipv4.GetAvailableLength() - 8

		for (var i = 0; i < length; i++) {
			var value: byte = 0x00

			if (ipv4.TryRead(8 + i, value) != PacketDataResult.Success || data.TryWrite(i, value) != PacketDataResult.Success) {
				this.Invalidate()
				return PacketDataResult.Invalid
			}
		}

		ipv4.Invalidate()
		ethernet.Invalidate()
		data.TryPublish()
		var result = reply.TryPrepare(identifier, sequence)

		if (result == PacketDataResult.Success) { result = ip.TryPrepare(localIp, peerIp, identification) }
		if (result == PacketDataResult.Success) { result = frame.TryPrepare(localMac, peerMac) }
		if (result != PacketDataResult.Success) { this.Invalidate() }

		return result
	}
	override fn IsReady() bool { return frame.IsReady() }
	override fn GetAvailableLength() int { return frame.GetAvailableLength() }
	override fn TryRead(index: int, value: out byte) PacketDataResult { return frame.TryRead(index, value) }
}
