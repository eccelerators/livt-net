namespace Livt.Net

/**
 * RFC 9293 — Transmission Control Protocol (TCP) (section 3.5, Connection Establishment)
 * https://www.rfc-editor.org/rfc/rfc9293
 *
 * Composes a minimum-sized Ethernet/IPv4/TCP SYN-ACK response frame byte by byte.
 */
component TcpSynAckFrameComposer<FRAME_CAPACITY: int = 128>
{
	static assert FRAME_CAPACITY >= 54, "Frame capacity must hold the required protocol header"

	// Number of bytes in the composed SYN-ACK frame, padded to Ethernet minimum.
	public const FRAME_LENGTH: int = 60

	// IPv4 total length for a bare TCP SYN-ACK (20 IP + 20 TCP = 40).
	public const IPV4_TOTAL_LENGTH: int = 40

	// TCP SYN-ACK flags byte.
	public const TCP_FLAGS_SYN_ACK: byte = 0x12

	// Owned byte builders for each response layer.
	ethernet: EthernetFrameBuilder<FRAME_CAPACITY>
	ipv4: Ipv4HeaderBuilder<FRAME_CAPACITY>
	tcp: TcpSegmentBuilder<FRAME_CAPACITY>

	/**
	 * Creates the owned Ethernet, IPv4 and TCP byte builders; no frame is emitted.
	 */
	new()
	{
		this.ethernet = new EthernetFrameBuilder<FRAME_CAPACITY>()
		this.ipv4 = new Ipv4HeaderBuilder<FRAME_CAPACITY>()
		this.tcp = new TcpSegmentBuilder<FRAME_CAPACITY>()
	}

	/**
	 * Returns one byte of the SYN-ACK frame.
	 * Bytes 0–13: Ethernet II reply header.
	 * Bytes 14–33: IPv4 header (total-length=40, proto=TCP, src=localIp, dst=request src IP).
	 * Bytes 34–53: TCP header (src/dst port swapped, SYN-ACK flags, seq/ack/window/checksum).
	 * Bytes 54–59: zero padding to Ethernet minimum frame size.
	 */
	public fn GetFrameByte(
		request: byte[FRAME_CAPACITY],
		index: int,
		localMac: byte[6],
		localIp: byte[4],
		ipv4Checksum: byte[2],
		ourSeq: byte[4],
		ackNum: byte[4],
		window: byte[2],
		tcpChecksum: byte[2]) logic[8]
	{
		if (index < 0) {
			return 0x00
		}

		if (index < 14) {
			return this.ethernet.GetReplyHeaderByte(request, index, localMac, 0x08, 0x00)
		}

		if (index < 34) {
			if (index == 24) {
				return ipv4Checksum[0]
			}

			if (index == 25) {
				return ipv4Checksum[1]
			}

			return this.ipv4.GetResponseHeaderByte(request, index - 14, IPV4_TOTAL_LENGTH, 0x00, 0x02, localIp)
		}

		if (index < 54) {
			return this.tcp.GetResponseHeaderByte(request, index - 34, ourSeq, ackNum, TCP_FLAGS_SYN_ACK, window, tcpChecksum)
		}

		return 0x00
	}
}
