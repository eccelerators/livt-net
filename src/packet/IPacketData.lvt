namespace Livt.Net

/** Result of a checked packet-data operation. Failed read output is not data. */
enum PacketDataResult
{
	Success
	NotReady
	Busy
	Invalid
}

/**
 * Scheduled read-only access to a stable, published byte prefix.
 * One serialized owner in the same clock/reset context. The owner must keep
 * the source published and unchanged until all dependent regions are closed.
 * Protocol identity, declared length and wire-length knowledge are separate.
 */
interface IPacketData
{
	fn IsReady() bool
	fn GetAvailableLength() int
	fn TryRead(index: int, value: out byte) PacketDataResult
}
