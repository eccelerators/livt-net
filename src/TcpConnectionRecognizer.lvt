namespace Livt.Net

/**
 * RFC 9293 — Transmission Control Protocol (TCP) (section 3.5, Connection Establishment)
 * https://www.rfc-editor.org/rfc/rfc9293
 *
 * Recognizes TCP SYN and ACK-only segments for the minimal three-way handshake FSM.
 */
component TcpConnectionRecognizer<FRAME_CAPACITY: int = 128>
{
	static assert FRAME_CAPACITY >= 54, "Frame capacity must hold the required protocol header"
	ipv4: Ipv4PacketParser<FRAME_CAPACITY>
	tcp: TcpHeaderParser<FRAME_CAPACITY>

	new()
	{
		this.ipv4 = new Ipv4PacketParser<FRAME_CAPACITY>()
		this.tcp = new TcpHeaderParser<FRAME_CAPACITY>()
	}

	/**
	 * Returns true for an IPv4/TCP SYN-only segment targeting localIp/localPort.
	 * Does not require a fixed 20-byte TCP header because host stacks often include
	 * TCP options in the SYN.
	 */
	public fn IsSynRequest(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2]) bool
	{
		return this.IsSynRequest(frame, localIp, localPort, FRAME_CAPACITY)
	}

	/** Checks a caller-supplied valid prefix length before reading header bytes. */
	public fn IsSynRequest(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2], validLength: int) bool
	{
		if (validLength < 54 || validLength > FRAME_CAPACITY) { return false }
		return frame[12] == 0x08
			&& frame[13] == 0x00
			&& this.ipv4.IsTcpForIpv4(frame, localIp[0], localIp[1], localIp[2], localIp[3])
			&& this.tcp.IsForLocalPort(frame, localPort[0], localPort[1])
			&& this.tcp.IsSynOnly(frame)
	}

	/**
	 * Returns true for an IPv4/TCP ACK-only segment targeting localIp/localPort.
	 */
	public fn IsAckOnlyPacket(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2]) bool
	{
		return this.IsAckOnlyPacket(frame, localIp, localPort, FRAME_CAPACITY)
	}

	/** Checks a caller-supplied valid prefix length before reading header bytes. */
	public fn IsAckOnlyPacket(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2], validLength: int) bool
	{
		if (validLength < 54 || validLength > FRAME_CAPACITY) { return false }
		return frame[12] == 0x08
			&& frame[13] == 0x00
			&& this.ipv4.IsTcpForIpv4(frame, localIp[0], localIp[1], localIp[2], localIp[3])
			&& this.tcp.IsFixedHeaderForLocalPort(frame, localPort[0], localPort[1])
			&& this.tcp.IsAckOnly(frame)
	}

	/**
	 * Returns true for an IPv4/TCP PSH+ACK segment targeting localIp/localPort.
	 * Some host TCP stacks combine the three-way handshake ACK with the first
	 * data segment (PSH+ACK, flags 0x18), skipping the ACK-only frame.
	 */
	public fn IsPshAckPacket(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2]) bool
	{
		return this.IsPshAckPacket(frame, localIp, localPort, FRAME_CAPACITY)
	}

	/** Checks a caller-supplied valid prefix length before reading header bytes. */
	public fn IsPshAckPacket(frame: byte[FRAME_CAPACITY], localIp: byte[4], localPort: byte[2], validLength: int) bool
	{
		if (validLength < 54 || validLength > FRAME_CAPACITY) { return false }
		return frame[12] == 0x08
			&& frame[13] == 0x00
			&& this.ipv4.IsTcpForIpv4(frame, localIp[0], localIp[1], localIp[2], localIp[3])
			&& this.tcp.IsFixedHeaderForLocalPort(frame, localPort[0], localPort[1])
			&& this.tcp.IsPshAck(frame)
	}
}
