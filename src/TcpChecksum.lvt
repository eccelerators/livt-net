namespace Livt.Net

/**
 * RFC 9293 — Transmission Control Protocol (TCP) (section 3.1, Checksum)
 * https://www.rfc-editor.org/rfc/rfc9293
 *
 * Calculates one's-complement TCP checksums for fixed 20-byte TCP headers.
 * All scalar byte arguments must be in 0..255. tcpLength includes the 20-byte
 * header; payloadWordSum must be non-negative and correspond to that payload,
 * padded with a trailing zero byte when odd. The complete unfolded sum must
 * fit a non-negative int (at most 2147483647).
 */
component TcpChecksum
{
	/**
	 * Calculates a TCP checksum over the pseudo-header and fixed 20-byte TCP header without payload.
	 * Returns the 16-bit one's-complement checksum as an int.
	 */
	public fn CalculateFixedHeaderChecksum(
		localIp0: int,
		localIp1: int,
		localIp2: int,
		localIp3: int,
		remoteIp0: int,
		remoteIp1: int,
		remoteIp2: int,
		remoteIp3: int,
		localPortHigh: int,
		localPortLow: int,
		remotePortHigh: int,
		remotePortLow: int,
		sequence0: int,
		sequence1: int,
		sequence2: int,
		sequence3: int,
		acknowledgment0: int,
		acknowledgment1: int,
		acknowledgment2: int,
		acknowledgment3: int,
		flags: int,
		windowHigh: int,
		windowLow: int) int
	{
		return this.CalculateChecksum(localIp0, localIp1, localIp2, localIp3, remoteIp0, remoteIp1, remoteIp2, remoteIp3, localPortHigh, localPortLow, remotePortHigh, remotePortLow, sequence0, sequence1, sequence2, sequence3, acknowledgment0, acknowledgment1, acknowledgment2, acknowledgment3, flags, windowHigh, windowLow, 20, 0)
	}

	/**
	 * Calculates a TCP checksum over the pseudo-header, fixed 20-byte TCP header,
	 * and the supplied payload word sum (from InternetChecksum.GetWordSum()).
	 * Returns the 16-bit one's-complement checksum as an int.
	 */
	public fn CalculatePayloadChecksum(
		localIp0: int,
		localIp1: int,
		localIp2: int,
		localIp3: int,
		remoteIp0: int,
		remoteIp1: int,
		remoteIp2: int,
		remoteIp3: int,
		localPortHigh: int,
		localPortLow: int,
		remotePortHigh: int,
		remotePortLow: int,
		sequence0: int,
		sequence1: int,
		sequence2: int,
		sequence3: int,
		acknowledgment0: int,
		acknowledgment1: int,
		acknowledgment2: int,
		acknowledgment3: int,
		flags: int,
		windowHigh: int,
		windowLow: int,
		tcpLength: int,
		payloadWordSum: int) int
	{
		return this.CalculateChecksum(localIp0, localIp1, localIp2, localIp3, remoteIp0, remoteIp1, remoteIp2, remoteIp3, localPortHigh, localPortLow, remotePortHigh, remotePortLow, sequence0, sequence1, sequence2, sequence3, acknowledgment0, acknowledgment1, acknowledgment2, acknowledgment3, flags, windowHigh, windowLow, tcpLength, payloadWordSum)
	}

	/**
	 * Returns the high byte of a 16-bit checksum value.
	 */
	public fn GetHighByte(checksum: int) int
	{
		return checksum / 256
	}

	/**
	 * Returns the low byte of a 16-bit checksum value.
	 */
	public fn GetLowByte(checksum: int) int
	{
		return checksum % 256
	}

	/**
	 * Network-order arrays; payload sums come from InternetChecksum.GetWordSum().
	 */
	public fn CalculateFixedHeaderChecksumFromBytes(
		localIp: byte[4], remoteIp: byte[4],
		localPort: byte[2], remotePort: byte[2],
		sequence: byte[4], acknowledgment: byte[4], flags: byte, window: byte[2]) int
	{
		return this.CalculateFixedHeaderChecksum(
			localIp[0] as int, localIp[1] as int, localIp[2] as int, localIp[3] as int,
			remoteIp[0] as int, remoteIp[1] as int, remoteIp[2] as int, remoteIp[3] as int,
			localPort[0] as int, localPort[1] as int, remotePort[0] as int, remotePort[1] as int,
			sequence[0] as int, sequence[1] as int, sequence[2] as int, sequence[3] as int,
			acknowledgment[0] as int, acknowledgment[1] as int, acknowledgment[2] as int, acknowledgment[3] as int,
			flags as int, window[0] as int, window[1] as int)
	}

	/**
	 * Network-order arrays; payload sums come from InternetChecksum.GetWordSum().
	 */
	public fn CalculatePayloadChecksumFromBytes(
		localIp: byte[4], remoteIp: byte[4],
		localPort: byte[2], remotePort: byte[2],
		sequence: byte[4], acknowledgment: byte[4], flags: byte, window: byte[2],
		tcpLength: int, payloadWordSum: int) int
	{
		return this.CalculatePayloadChecksum(
			localIp[0] as int, localIp[1] as int, localIp[2] as int, localIp[3] as int,
			remoteIp[0] as int, remoteIp[1] as int, remoteIp[2] as int, remoteIp[3] as int,
			localPort[0] as int, localPort[1] as int, remotePort[0] as int, remotePort[1] as int,
			sequence[0] as int, sequence[1] as int, sequence[2] as int, sequence[3] as int,
			acknowledgment[0] as int, acknowledgment[1] as int, acknowledgment[2] as int, acknowledgment[3] as int,
			flags as int, window[0] as int, window[1] as int, tcpLength,
			payloadWordSum)
	}

	/**
	 * Combines the IPv4 pseudo-header, fixed TCP header and unfolded payload sum.
	 * Caller-supplied octets and total sum must satisfy the component bounds.
	 */
	fn CalculateChecksum(
		localIp0: int,
		localIp1: int,
		localIp2: int,
		localIp3: int,
		remoteIp0: int,
		remoteIp1: int,
		remoteIp2: int,
		remoteIp3: int,
		localPortHigh: int,
		localPortLow: int,
		remotePortHigh: int,
		remotePortLow: int,
		sequence0: int,
		sequence1: int,
		sequence2: int,
		sequence3: int,
		acknowledgment0: int,
		acknowledgment1: int,
		acknowledgment2: int,
		acknowledgment3: int,
		flags: int,
		windowHigh: int,
		windowLow: int,
		tcpLength: int,
		payloadWordSum: int) int
	{
		var sum: int = 0

		sum = sum + ChecksumArithmetic.Word(localIp0, localIp1)
		sum = sum + ChecksumArithmetic.Word(localIp2, localIp3)
		sum = sum + ChecksumArithmetic.Word(remoteIp0, remoteIp1)
		sum = sum + ChecksumArithmetic.Word(remoteIp2, remoteIp3)
		sum = sum + 0x0006
		sum = sum + tcpLength
		sum = sum + ChecksumArithmetic.Word(localPortHigh, localPortLow)
		sum = sum + ChecksumArithmetic.Word(remotePortHigh, remotePortLow)
		sum = sum + ChecksumArithmetic.Word(sequence0, sequence1)
		sum = sum + ChecksumArithmetic.Word(sequence2, sequence3)
		sum = sum + ChecksumArithmetic.Word(acknowledgment0, acknowledgment1)
		sum = sum + ChecksumArithmetic.Word(acknowledgment2, acknowledgment3)
		sum = sum + 0x5000 + flags
		sum = sum + ChecksumArithmetic.Word(windowHigh, windowLow)
		sum = sum + payloadWordSum

		return ChecksumArithmetic.Finish(sum)
	}
}
