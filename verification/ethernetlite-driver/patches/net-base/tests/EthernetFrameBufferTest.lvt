namespace Livt.Net.Tests

using Livt.Net

/** Buffer ownership and write-before-read contracts without an active AXI slave. */
@Test
component EthernetFrameBufferTest
{
	axi: Axi4LiteEthernetLiteAdapter
	io: EthernetFrameIo
	queuedAxi: Axi4LiteEthernetLiteAdapter
	queued: EthernetFrameIo

	new()
	{
		var mac: byte[6] = [0x02, 0x00, 0x00, 0x00, 0x00, 0x01]
		this.axi = new Axi4LiteEthernetLiteAdapter()
		this.io = new EthernetFrameIo(this.axi, mac)
		this.queuedAxi = new Axi4LiteEthernetLiteAdapter()
		this.queued = new EthernetFrameIo(this.queuedAxi, mac)
	}

	@Test
	fn RejectsInvalidAndIncompleteFrames()
	{
		assert this.queued.TryBeginTxFrame(-1) == false
		assert this.queued.TryBeginTxFrame(0) == false
		assert this.queued.TryBeginTxFrame(2037) == false
		assert this.queued.TrySubmitTxFrame() == false
		assert this.queued.GetTxLength() == 0
		assert this.queued.TryBeginTxFrame(2) == true
		assert this.queued.TryWriteTxByte(1, 0xEE) == false
		assert this.queued.TryWriteTxByte(-1, 0xEE) == false
		assert this.queued.TryWriteTxByte(2, 0xEE) == false
		assert this.queued.TryWriteTxByte(0, 0x80) == true
		assert this.queued.GetTxByte(0) == 0x80
		assert this.queued.GetTxByte(1) == 0x00
		assert this.queued.TrySubmitTxFrame() == false
		assert this.queued.TryWriteTxByte(1, 0xFF) == true
		assert this.queued.TrySubmitTxFrame() == true
		assert this.queued.TrySubmitTxFrame() == false
		assert this.queued.TryBeginTxFrame(1) == false
		assert this.queued.TryWriteTxByte(0, 0x00) == false
		this.queued.ConsumeTxFrame()
		assert this.queued.HasTxFrame() == true
		assert this.queued.GetTxLength() == 2
	}

	@Test
	fn InvalidatesRetainedPayloadOnBegin()
	{
		this.io.BeginTxFrame(2)
		this.io.WriteTxByte(0, 0xFE)
		this.io.WriteTxByte(1, 0xDC)
		this.io.BeginTxFrame(1)
		assert this.io.GetTxByte(0) == 0x00
		assert this.io.GetTxByte(1) == 0x00
		assert this.io.TrySubmitTxFrame() == false
		this.io.WriteTxByte(0, 0x81)
		assert this.io.GetTxByte(0) == 0x81
		this.io.ConsumeTxFrame()
		assert this.io.GetTxByte(0) == 0x00
		assert this.io.GetTxLength() == 0
	}

	@Test
	fn PublishesOnlyInitializedInjectedRx()
	{
		assert this.io.GetRxByte(0) == 0x00
		this.io.LoadRxByte(1, 0xFF)
		this.io.SubmitRxFrame()
		assert this.io.IsFrameAvailable() == false
		for (var i = 0; i < 128; i++) { this.io.LoadRxByte(i, (i + 128) as byte) }
		this.io.SubmitRxFrame()
		assert this.io.IsFrameAvailable() == true
		assert this.io.GetRxByte(0) == 0x80
		assert this.io.GetRxByte(127) == 0xFF
		assert this.io.GetRxByte(-1) == 0x00
		assert this.io.GetRxByte(128) == 0x00
		this.io.LoadRxByte(0, 0x00)
		assert this.io.GetRxByte(0) == 0x80
		this.io.ConsumeRxFrame()
		this.io.SubmitRxFrame()
		assert this.io.IsFrameAvailable() == false
		assert this.io.GetRxByte(0) == 0x00
	}

	@Test
	fn PacksNetworkBytesIntoLowFirstAxiLanes()
	{
		assert this.io.PackTxWord(0x80, 0x01, 0xFE, 0x7F) == 0x7FFE0180
	}
}
