namespace Livt.Net

/** Prepared packet bytes. Unprepared length and invalid-index reads return zero. */
interface IPacketBytes
{
	fn GetLength() int
	fn GetByte(index: int) byte
}

/** Capability identifying an Ethernet II payload's EtherType. */
interface IEthernetPayload
{
	fn GetEtherType() int
}

/** Capability identifying an IPv4 payload's protocol number. */
interface IIpv4Payload
{
	fn GetProtocol() int
}
