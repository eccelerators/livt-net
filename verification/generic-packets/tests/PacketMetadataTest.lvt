namespace Livt.Net.Tests

using Livt.Net

/** A caller-defined payload proves the envelopes do not depend on built-in leaf types. */
component PacketMetadataStub : IPacketBytes, IEthernetPayload, IIpv4Payload
{
	length: int
	etherType: int
	protocol: int
	public fn Configure(length: int, etherType: int, protocol: int)
	{
		this.length = length
		this.etherType = etherType
		this.protocol = protocol
	}
	override fn GetLength() int { return length }
	override fn GetEtherType() int { return etherType }
	override fn GetProtocol() int { return protocol }
	override fn GetByte(index: int) byte { return 0xA5 }
}

@Test
component PacketMetadataTest
{
	payload: PacketMetadataStub
	frame: EthernetFrame<PacketMetadataStub>
	ip: Ipv4Packet<PacketMetadataStub>
	new()
	{
		payload = new PacketMetadataStub()
		frame = new EthernetFrame<PacketMetadataStub>(payload)
		ip = new Ipv4Packet<PacketMetadataStub>(payload)
	}

	@Test
	fn ChecksEnvelopeLimitsAndCustomPayload()
	{
		var mac: byte[6] = [0x02, 0x01, 0x02, 0x03, 0x04, 0x05]
		var ipAddress: byte[4] = [0x0A, 0x00, 0x00, 0x01]
		var id: byte[2] = [0x00, 0x00]
		payload.Configure(1, 0x88B5, 17)
		assert frame.TryPrepare(mac, mac)
		assert frame.GetLength() == 60
		assert frame.GetByte(12) == 0x88
		assert frame.GetByte(13) == 0xB5
		assert frame.GetByte(14) == 0xA5
		for (var i = 15; i < 60; i++) { assert frame.GetByte(i) == 0x00 }
		assert ip.TryPrepare(ipAddress, ipAddress, id)
		assert ip.GetLength() == 21
		assert ip.GetByte(9) == 0x11
		assert ip.GetByte(20) == 0xA5
		frame.Invalidate()
		ip.Invalidate()
		payload.Configure(0, 0x0800, 1)
		assert !frame.TryPrepare(mac, mac)
		assert !ip.TryPrepare(ipAddress, ipAddress, id)
		payload.Configure(-1, 0x0800, 1)
		assert !frame.TryPrepare(mac, mac)
		assert !ip.TryPrepare(ipAddress, ipAddress, id)
		payload.Configure(1501, 0x0800, 1)
		assert !frame.TryPrepare(mac, mac)
		payload.Configure(1, 1535, 1)
		assert !frame.TryPrepare(mac, mac)
		payload.Configure(1, 65536, 1)
		assert !frame.TryPrepare(mac, mac)
		payload.Configure(65516, 0x0800, 1)
		assert !ip.TryPrepare(ipAddress, ipAddress, id)
		payload.Configure(1, 0x0800, -1)
		assert !ip.TryPrepare(ipAddress, ipAddress, id)
		payload.Configure(1, 0x0800, 256)
		assert !ip.TryPrepare(ipAddress, ipAddress, id)
		assert ip.GetLength() == 0
		assert ip.GetByte(0) == 0x00
		assert frame.GetLength() == 0
		assert frame.GetByte(0) == 0x00
		payload.Configure(65515, 0x0800, 1)
		assert ip.TryPrepare(ipAddress, ipAddress, id)
		assert ip.GetLength() == 65535
		assert ip.GetByte(2) == 0xFF
		assert ip.GetByte(3) == 0xFF
		assert ip.GetByte(65535) == 0x00
	}
}
