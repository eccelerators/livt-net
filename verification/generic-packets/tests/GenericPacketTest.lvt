namespace Livt.Net.Tests

using Livt.Net

component NestedPacketChecks<CAPACITY: int>
{
	echo: IcmpEchoReply<CAPACITY>
	ip: Ipv4Packet<IcmpEchoReply<CAPACITY>>
	frame: EthernetFrame<Ipv4Packet<IcmpEchoReply<CAPACITY>>>
	limited: EthernetFrame<Ipv4Packet<IcmpEchoReply<CAPACITY>>, 31>
	new()
	{
		echo = new IcmpEchoReply<CAPACITY>()
		ip = new Ipv4Packet<IcmpEchoReply<CAPACITY>>(echo)
		frame = new EthernetFrame<Ipv4Packet<IcmpEchoReply<CAPACITY>>>(ip)
		limited = new EthernetFrame<Ipv4Packet<IcmpEchoReply<CAPACITY>>, 31>(ip)
	}

	public fn Check()
	{
		var mac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var peer: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var sourceIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var targetIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var identification: byte[2] = [0x12, 0x34]
		var identifier: byte[2] = [0xAB, 0xCD]
		var sequence: byte[2] = [0x80, 0xFE]
		var data: byte[CAPACITY]
		for (var i = 0; i < CAPACITY; i++) { data[i] = (128 + i) as byte }
		assert echo.GetLength() == 0
		assert ip.GetLength() == 0
		assert frame.GetLength() == 0
		assert frame.GetByte(0) == 0x00
		assert ip.GetByte(0) == 0x00
		assert echo.GetByte(0) == 0x00
		assert !ip.TryPrepare(sourceIp, targetIp, identification)
		assert !frame.TryPrepare(mac, peer)

		// Independent complete wire vector: 32 echo data bytes.
		var expected32: byte[74] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE,
			0x08, 0x00, 0x45, 0x00, 0x00, 0x3C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01,
			0xA3, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00,
			0xDA, 0x2A, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85,
			0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91,
			0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D,
			0x9E, 0x9F]
		frame.Invalidate()
		limited.Invalidate()
		ip.Invalidate()
		assert echo.TryPrepare(identifier, sequence, data, 32)
		assert ip.TryPrepare(sourceIp, targetIp, identification)
		assert frame.TryPrepare(mac, peer)
		assert echo.GetLength() == 40
		assert ip.GetLength() == 60
		assert frame.GetLength() == 74
		for (var i = 0; i < 74; i++) { assert frame.GetByte(i) == expected32[i] }
		assert frame.GetByte(-1) == 0x00
		assert frame.GetByte(74) == 0x00
		assert ip.GetByte(60) == 0x00
		assert echo.GetByte(40) == 0x00
		assert limited.TryPrepare(mac, peer) == false
		assert limited.GetLength() == 0
		assert limited.GetByte(0) == 0x00

		// Independent complete wire vector: 3 echo data bytes.
		var expected3: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE,
			0x08, 0x00, 0x45, 0x00, 0x00, 0x1F, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01,
			0xA3, 0xDA, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00,
			0xD0, 0xB1, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		frame.Invalidate()
		limited.Invalidate()
		ip.Invalidate()
		assert echo.TryPrepare(identifier, sequence, data, 3)
		assert ip.TryPrepare(sourceIp, targetIp, identification)
		assert frame.TryPrepare(mac, peer)
		assert echo.GetLength() == 11
		assert ip.GetLength() == 31
		assert frame.GetLength() == 60
		for (var i = 0; i < 60; i++) { assert frame.GetByte(i) == expected3[i] }
		assert frame.GetByte(-1) == 0x00
		assert frame.GetByte(60) == 0x00
		assert ip.GetByte(31) == 0x00
		assert echo.GetByte(11) == 0x00
		assert limited.TryPrepare(mac, peer) == true

		// Independent complete wire vector: 4 echo data bytes.
		var expected4: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE,
			0x08, 0x00, 0x45, 0x00, 0x00, 0x20, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01,
			0xA3, 0xD9, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00,
			0xD0, 0x2E, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		frame.Invalidate()
		limited.Invalidate()
		ip.Invalidate()
		assert echo.TryPrepare(identifier, sequence, data, 4)
		assert ip.TryPrepare(sourceIp, targetIp, identification)
		assert frame.TryPrepare(mac, peer)
		assert echo.GetLength() == 12
		assert ip.GetLength() == 32
		assert frame.GetLength() == 60
		for (var i = 0; i < 60; i++) { assert frame.GetByte(i) == expected4[i] }
		assert frame.GetByte(-1) == 0x00
		assert frame.GetByte(60) == 0x00
		assert ip.GetByte(32) == 0x00
		assert echo.GetByte(12) == 0x00
		assert limited.TryPrepare(mac, peer) == false
		assert limited.GetLength() == 0
		assert limited.GetByte(0) == 0x00

		// Independent complete wire vector: 0 echo data bytes.
		var expected0: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE,
			0x08, 0x00, 0x45, 0x00, 0x00, 0x1C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01,
			0xA3, 0xDD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00,
			0xD3, 0x33, 0xAB, 0xCD, 0x80, 0xFE, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		frame.Invalidate()
		limited.Invalidate()
		ip.Invalidate()
		assert echo.TryPrepare(identifier, sequence, data, 0)
		assert ip.TryPrepare(sourceIp, targetIp, identification)
		assert frame.TryPrepare(mac, peer)
		assert echo.GetLength() == 8
		assert ip.GetLength() == 28
		assert frame.GetLength() == 60
		for (var i = 0; i < 60; i++) { assert frame.GetByte(i) == expected0[i] }
		assert frame.GetByte(-1) == 0x00
		assert frame.GetByte(60) == 0x00
		assert ip.GetByte(28) == 0x00
		assert echo.GetByte(8) == 0x00
		assert limited.TryPrepare(mac, peer) == true

		frame.Invalidate()
		limited.Invalidate()
		ip.Invalidate()
		assert !echo.TryPrepare(identifier, sequence, data, -1)
		assert echo.GetLength() == 0
		assert echo.GetByte(4) == 0x00
		assert !echo.TryPrepare(identifier, sequence, data, CAPACITY + 1)
		assert !ip.TryPrepare(sourceIp, targetIp, identification)
		assert !frame.TryPrepare(mac, peer)
		assert frame.GetLength() == 0
		assert frame.GetByte(6) == 0x00
	}
}

@Test
component GenericPacketTest
{
	small: NestedPacketChecks<32>
	large: NestedPacketChecks<96>
	defaults: NestedPacketChecks<128>
	arp: ArpReply
	arpFrame: EthernetFrame<ArpReply>
	new()
	{
		small = new NestedPacketChecks<32>()
		large = new NestedPacketChecks<96>()
		defaults = new NestedPacketChecks<128>()
		arp = new ArpReply()
		arpFrame = new EthernetFrame<ArpReply>(arp)
	}
	@Test
	fn NestedSmallCapacity() { small.Check() }
	@Test
	fn NestedLargeCapacity() { large.Check() }
	@Test
	fn NestedDefaultCapacity() { defaults.Check() }

	@Test
	fn ArpUsesTheSameEthernetEnvelope()
	{
		var mac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var peer: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var sourceIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var targetIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		assert arp.GetLength() == 0
		assert arp.GetByte(0) == 0x00
		assert !arpFrame.TryPrepare(mac, peer)
		arp.Prepare(mac, sourceIp, peer, targetIp)
		assert arpFrame.TryPrepare(mac, peer)
		assert arp.GetLength() == 28
		assert arpFrame.GetLength() == 60
		var expected: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE,
			0x08, 0x06, 0x00, 0x01, 0x08, 0x00, 0x06, 0x04, 0x00, 0x02, 0x02, 0xAA,
			0xBB, 0xCC, 0xDD, 0xEE, 0xC0, 0xA8, 0x01, 0x80, 0x82, 0x10, 0x20, 0x30,
			0x40, 0xFE, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		for (var i = 0; i < 60; i++) { assert arpFrame.GetByte(i) == expected[i] }
		assert arpFrame.GetByte(-1) == 0x00
		assert arpFrame.GetByte(60) == 0x00
		assert arp.GetByte(28) == 0x00
		arpFrame.Invalidate()
		arp.Invalidate()
		assert arpFrame.GetLength() == 0
		assert arp.GetLength() == 0
		assert !arpFrame.TryPrepare(mac, peer)
		// Re-prepare with swapped endpoints to detect retained header metadata.
		arp.Prepare(peer, targetIp, mac, sourceIp)
		assert arpFrame.TryPrepare(peer, mac)
		for (var i = 0; i < 6; i++) {
			assert arpFrame.GetByte(i) == mac[i]
			assert arpFrame.GetByte(6 + i) == peer[i]
			assert arpFrame.GetByte(22 + i) == peer[i]
			assert arpFrame.GetByte(32 + i) == mac[i]
		}
	}
}
