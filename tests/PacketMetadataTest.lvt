namespace Livt.Net.Tests
using Livt.Net

/** User-defined protocol data; injected read failures test preparation cleanup. */
component PacketMetadataStub : IPacketData, IEthernetPayload, IIpv4Payload
{
	length: int
	etherType: int
	protocol: int
	available: bool
	failAt: int
	public fn Configure(length: int, etherType: int, protocol: int, available: bool, failAt: int)
	{
		this.length = length
		this.etherType = etherType
		this.protocol = protocol
		this.available = available
		this.failAt = failAt
	}
	override fn IsReady() bool { return available }
	override fn GetAvailableLength() int { return length }
	override fn GetEtherType() int { return etherType }
	override fn GetProtocol() int { return protocol }
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00
		if (!available) { return PacketDataResult.NotReady }
		if (index < 0 || index >= length || index == failAt) { return PacketDataResult.Invalid }
		value = 0xA5
		return PacketDataResult.Success
	}
}
@Test
component PacketMetadataTest
{
	payload: PacketMetadataStub
	frame: EthernetFrame<PacketMetadataStub>
	ip: Ipv4Packet<PacketMetadataStub>
	echo: IcmpEchoReply<PacketMetadataStub>
	new()
	{
		payload = new PacketMetadataStub()
		frame = new EthernetFrame<PacketMetadataStub>(payload)
		ip = new Ipv4Packet<PacketMetadataStub>(payload)
		echo = new IcmpEchoReply<PacketMetadataStub>(payload)
	}
	@Test
	fn ChecksLimitsAndFailedReplacement()
	{
		var mac: byte[6] = [0x02, 0x01, 0x02, 0x03, 0x04, 0x05]
		var address: byte[4] = [0x0A, 0x00, 0x00, 0x01]
		var id: byte[2] = [0x00, 0x00]
		var value: byte = 0x00
		payload.Configure(1, 0x88B5, 17, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Success
		assert frame.GetAvailableLength() == 60
		assert frame.TryRead(12, value) == PacketDataResult.Success
		assert value == 0x88
		assert frame.TryRead(13, value) == PacketDataResult.Success
		assert value == 0xB5
		assert frame.TryRead(14, value) == PacketDataResult.Success
		assert value == 0xA5
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Success
		assert ip.GetAvailableLength() == 21
		assert ip.TryRead(9, value) == PacketDataResult.Success
		assert value == 0x11
		frame.Invalidate()
		ip.Invalidate()
		payload.Configure(0, 0x0800, 1, false, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.NotReady
		assert ip.TryPrepare(address, address, id) == PacketDataResult.NotReady
		payload.Configure(0, 0x0800, 1, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Invalid
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		payload.Configure(-1, 0x0800, 1, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Invalid
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		payload.Configure(1501, 0x0800, 1, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Invalid
		payload.Configure(1, 1535, 1, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Invalid
		payload.Configure(1, 65536, 1, true, -1)
		assert frame.TryPrepare(mac, mac) == PacketDataResult.Invalid
		payload.Configure(65516, 0x0800, 1, true, -1)
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		payload.Configure(1, 0x0800, -1, true, -1)
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		payload.Configure(1, 0x0800, 256, true, -1)
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		assert ip.GetAvailableLength() == 0
		assert frame.TryRead(0, value) == PacketDataResult.NotReady
		payload.Configure(65515, 0x0800, 1, true, -1)
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Success
		assert ip.GetAvailableLength() == 65535
		assert ip.TryRead(2, value) == PacketDataResult.Success
		assert value == 0xFF
		assert ip.TryRead(3, value) == PacketDataResult.Success
		assert value == 0xFF
		// Replacement failure clears previously prepared metadata.
		payload.Configure(1, 0x0800, 256, true, -1)
		assert ip.TryPrepare(address, address, id) == PacketDataResult.Invalid
		assert ip.IsReady() == false
		assert ip.TryRead(0, value) == PacketDataResult.NotReady
	}
	@Test
	fn PropagatesReadFailureAndRejectsOversizedEcho()
	{
		var id: byte[2] = [0x80, 0xFF]
		var value: byte = 0x00
		payload.Configure(3, 0x0800, 1, true, -1)
		assert echo.TryPrepare(id, id) == PacketDataResult.Success
		echo.Invalidate()
		payload.Configure(3, 0x0800, 1, true, 1)
		assert echo.TryPrepare(id, id) == PacketDataResult.Invalid
		assert echo.IsReady() == false
		assert echo.GetAvailableLength() == 0
		assert echo.TryRead(0, value) == PacketDataResult.NotReady
		payload.Configure(65508, 0x0800, 1, true, -1)
		assert echo.TryPrepare(id, id) == PacketDataResult.Invalid
		payload.Configure(-1, 0x0800, 1, true, -1)
		assert echo.TryPrepare(id, id) == PacketDataResult.Invalid
	}
}
