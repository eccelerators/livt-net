	@Test
	fn ArpEnvelopeAndReuse()
	{
		var mac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var peer: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var identification: byte[2] = [0x12, 0x34]
		var identifier: byte[2] = [0xAB, 0xCD]
		var sequence: byte[2] = [0x80, 0xFE]
		var value: byte = 0x00

		assert arpFrame.TryPrepare(mac, peer) == PacketDataResult.NotReady
		assert arp.TryRead(0, value) == PacketDataResult.NotReady
		assert arp.TryPrepare(mac, localIp, peer, remoteIp) == PacketDataResult.Success
		assert arpFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		var expected: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x06, 0x00, 0x01, 0x08, 0x00, 0x06, 0x04, 0x00, 0x02, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xC0, 0xA8, 0x01, 0x80, 0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 60; i++) {
			assert arpFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert arp.TryRead(28, value) == PacketDataResult.Invalid
		assert arpFrame.TryRead(60, value) == PacketDataResult.Invalid
		arpFrame.Invalidate()
		arp.Invalidate()
		assert arpFrame.TryPrepare(mac, peer) == PacketDataResult.NotReady
		assert arp.TryPrepare(peer, remoteIp, mac, localIp) == PacketDataResult.Success
		assert arpFrame.TryPrepare(peer, mac) == PacketDataResult.Success

		for (var i = 0; i < 6; i++) {
			assert arpFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == mac[i]
			assert arpFrame.TryRead(6 + i, value) == PacketDataResult.Success
			assert value == peer[i]
		}

		arpFrame.Invalidate()
		arp.Invalidate()
	}
}
