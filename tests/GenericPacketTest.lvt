namespace Livt.Net.Tests

using Livt.Net

@Test
component GenericPacketTest
{
	small: ArrayPacketData<32>
	smallEcho: IcmpEchoReply<ArrayPacketData<32>>
	smallIp: Ipv4Packet<IcmpEchoReply<ArrayPacketData<32>>>
	smallFrame: EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<32>>>>
	large: ArrayPacketData<128>
	largeEcho: IcmpEchoReply<ArrayPacketData<128>>
	largeIp: Ipv4Packet<IcmpEchoReply<ArrayPacketData<128>>>
	largeFrame: EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<128>>>>
	ram: RamPacketData<96>
	ramEcho: IcmpEchoReply<RamPacketData<96>>
	ramIp: Ipv4Packet<IcmpEchoReply<RamPacketData<96>>>
	ramFrame: EthernetFrame<Ipv4Packet<IcmpEchoReply<RamPacketData<96>>>>
	arp: ArpReply
	arpFrame: EthernetFrame<ArpReply>
	new()
	{
		small = new ArrayPacketData<32>()
		smallEcho = new IcmpEchoReply<ArrayPacketData<32>>(small)
		smallIp = new Ipv4Packet<IcmpEchoReply<ArrayPacketData<32>>>(smallEcho)
		smallFrame = new EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<32>>>>(smallIp)
		large = new ArrayPacketData<128>()
		largeEcho = new IcmpEchoReply<ArrayPacketData<128>>(large)
		largeIp = new Ipv4Packet<IcmpEchoReply<ArrayPacketData<128>>>(largeEcho)
		largeFrame = new EthernetFrame<Ipv4Packet<IcmpEchoReply<ArrayPacketData<128>>>>(largeIp)
		ram = new RamPacketData<96>()
		ramEcho = new IcmpEchoReply<RamPacketData<96>>(ram)
		ramIp = new Ipv4Packet<IcmpEchoReply<RamPacketData<96>>>(ramEcho)
		ramFrame = new EthernetFrame<Ipv4Packet<IcmpEchoReply<RamPacketData<96>>>>(ramIp)
		arp = new ArpReply()
		arpFrame = new EthernetFrame<ArpReply>(arp)
	}

	@Test
	fn SmallCompleteFrames()
	{
		var mac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var peer: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var identification: byte[2] = [0x12, 0x34]
		var identifier: byte[2] = [0xAB, 0xCD]
		var sequence: byte[2] = [0x80, 0xFE]
		var value: byte = 0x00
		assert smallEcho.TryRead(0, value) == PacketDataResult.NotReady
		assert smallIp.TryRead(0, value) == PacketDataResult.NotReady
		assert smallFrame.TryRead(0, value) == PacketDataResult.NotReady
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.NotReady

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected0: byte[74] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x3C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xDA, 0x2A, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F]

		for (var i = 0; i < 32; i++) {
			assert small.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 40
		assert smallIp.GetAvailableLength() == 60
		assert smallFrame.GetAvailableLength() == 74
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 74; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected0[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(74, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(60, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(40, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected1: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x1F, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xDA, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD0, 0xB1, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 3; i++) {
			assert small.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 11
		assert smallIp.GetAvailableLength() == 31
		assert smallFrame.GetAvailableLength() == 60
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected1[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(31, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(11, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected2: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x20, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xD9, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD0, 0x2E, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 4; i++) {
			assert small.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 12
		assert smallIp.GetAvailableLength() == 32
		assert smallFrame.GetAvailableLength() == 60
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected2[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(32, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(12, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected3: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x1C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xDD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD3, 0x33, 0xAB, 0xCD, 0x80, 0xFE, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 0; i++) {
			assert small.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 8
		assert smallIp.GetAvailableLength() == 28
		assert smallFrame.GetAvailableLength() == 60
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected3[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(28, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(8, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected4: byte[74] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x3C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xDA, 0x2A, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F]

		for (var i = 0; i < 32; i++) {
			assert small.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 40
		assert smallIp.GetAvailableLength() == 60
		assert smallFrame.GetAvailableLength() == 74
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 74; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected4[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(74, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(60, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(40, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected5: byte[74] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x3C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xCA, 0x1A, 0xAB, 0xCD, 0x80, 0xFE, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F, 0xA0]

		for (var i = 0; i < 32; i++) {
			assert small.TryWrite(i, (129 + i) as byte) == PacketDataResult.Success
		}

		assert small.TryPublish() == PacketDataResult.Success
		assert smallEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert smallIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert smallFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert smallEcho.GetAvailableLength() == 40
		assert smallIp.GetAvailableLength() == 60
		assert smallFrame.GetAvailableLength() == 74
		assert small.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 74; i++) {
			assert smallFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected5[i]
		}

		assert smallFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert smallFrame.TryRead(74, value) == PacketDataResult.Invalid
		assert smallIp.TryRead(60, value) == PacketDataResult.Invalid
		assert smallEcho.TryRead(40, value) == PacketDataResult.Invalid
		smallFrame.Invalidate()
		smallIp.Invalidate()
		smallEcho.Invalidate()
		assert small.TryRelease() == PacketDataResult.Success
	}

	@Test
	fn LargeCompleteFrames()
	{
		var mac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var peer: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var identification: byte[2] = [0x12, 0x34]
		var identifier: byte[2] = [0xAB, 0xCD]
		var sequence: byte[2] = [0x80, 0xFE]
		var value: byte = 0x00
		assert largeEcho.TryRead(0, value) == PacketDataResult.NotReady
		assert largeIp.TryRead(0, value) == PacketDataResult.NotReady
		assert largeFrame.TryRead(0, value) == PacketDataResult.NotReady
		assert largeEcho.TryPrepare(identifier, sequence) == PacketDataResult.NotReady

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected0: byte[74] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x3C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xBD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xDA, 0x2A, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x8B, 0x8C, 0x8D, 0x8E, 0x8F, 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0x9B, 0x9C, 0x9D, 0x9E, 0x9F]

		for (var i = 0; i < 32; i++) {
			assert large.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert large.TryPublish() == PacketDataResult.Success
		assert largeEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert largeIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert largeFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert largeEcho.GetAvailableLength() == 40
		assert largeIp.GetAvailableLength() == 60
		assert largeFrame.GetAvailableLength() == 74
		assert large.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 74; i++) {
			assert largeFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected0[i]
		}

		assert largeFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert largeFrame.TryRead(74, value) == PacketDataResult.Invalid
		assert largeIp.TryRead(60, value) == PacketDataResult.Invalid
		assert largeEcho.TryRead(40, value) == PacketDataResult.Invalid
		largeFrame.Invalidate()
		largeIp.Invalidate()
		largeEcho.Invalidate()
		assert large.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected1: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x1F, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xDA, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD0, 0xB1, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 3; i++) {
			assert large.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert large.TryPublish() == PacketDataResult.Success
		assert largeEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert largeIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert largeFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert largeEcho.GetAvailableLength() == 11
		assert largeIp.GetAvailableLength() == 31
		assert largeFrame.GetAvailableLength() == 60
		assert large.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert largeFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected1[i]
		}

		assert largeFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert largeFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert largeIp.TryRead(31, value) == PacketDataResult.Invalid
		assert largeEcho.TryRead(11, value) == PacketDataResult.Invalid
		largeFrame.Invalidate()
		largeIp.Invalidate()
		largeEcho.Invalidate()
		assert large.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected2: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x20, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xD9, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD0, 0x2E, 0xAB, 0xCD, 0x80, 0xFE, 0x80, 0x81, 0x82, 0x83, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 4; i++) {
			assert large.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert large.TryPublish() == PacketDataResult.Success
		assert largeEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert largeIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert largeFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert largeEcho.GetAvailableLength() == 12
		assert largeIp.GetAvailableLength() == 32
		assert largeFrame.GetAvailableLength() == 60
		assert large.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert largeFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected2[i]
		}

		assert largeFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert largeFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert largeIp.TryRead(32, value) == PacketDataResult.Invalid
		assert largeEcho.TryRead(12, value) == PacketDataResult.Invalid
		largeFrame.Invalidate()
		largeIp.Invalidate()
		largeEcho.Invalidate()
		assert large.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
		var expected3: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x1C, 0x12, 0x34, 0x40, 0x00, 0x40, 0x01, 0xA3, 0xDD, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x00, 0xD3, 0x33, 0xAB, 0xCD, 0x80, 0xFE, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]

		for (var i = 0; i < 0; i++) {
			assert large.TryWrite(i, (128 + i) as byte) == PacketDataResult.Success
		}

		assert large.TryPublish() == PacketDataResult.Success
		assert largeEcho.TryPrepare(identifier, sequence) == PacketDataResult.Success
		assert largeIp.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert largeFrame.TryPrepare(mac, peer) == PacketDataResult.Success
		assert largeEcho.GetAvailableLength() == 8
		assert largeIp.GetAvailableLength() == 28
		assert largeFrame.GetAvailableLength() == 60
		assert large.TryWrite(0, 0x00) == PacketDataResult.Busy

		for (var i = 0; i < 60; i++) {
			assert largeFrame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected3[i]
		}

		assert largeFrame.TryRead(-1, value) == PacketDataResult.Invalid
		assert largeFrame.TryRead(60, value) == PacketDataResult.Invalid
		assert largeIp.TryRead(28, value) == PacketDataResult.Invalid
		assert largeEcho.TryRead(8, value) == PacketDataResult.Invalid
		largeFrame.Invalidate()
		largeIp.Invalidate()
		largeEcho.Invalidate()
		assert large.TryRelease() == PacketDataResult.Success

		// Independent complete frame vector; includes checksum and padding bytes.
