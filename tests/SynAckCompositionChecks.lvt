namespace Livt.Net.Tests
using Livt.Net

/** Independent complete SYN-ACK vector at multiple provider capacities. */
@Test
component SynAckCompositionChecks<CAPACITY: int>
{
	data: ArrayPacketData<CAPACITY>
	segment: TcpSegment<ArrayPacketData<CAPACITY>>
	packet: TcpIpv4Packet<ArrayPacketData<CAPACITY>>
	frame: TcpIpv4Frame<ArrayPacketData<CAPACITY>>
	new()
	{
		this.data = new ArrayPacketData<CAPACITY>()
		this.segment = new TcpSegment<ArrayPacketData<CAPACITY>>(this.data)
		this.packet = new TcpIpv4Packet<ArrayPacketData<CAPACITY>>(this.segment)
		this.frame = new TcpIpv4Frame<ArrayPacketData<CAPACITY>>(this.packet)
	}

	public fn Check()
	{
		this.frame.Invalidate()
		this.packet.Invalidate()
		this.segment.Invalidate()

		if (this.data.IsReady()) {
			this.data.TryRelease()
		}
		else {
			this.data.TryClear()
		}

		assert this.data.TryPublish() == PacketDataResult.Success
		var localMac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var remoteMac: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		var sourcePort: byte[2] = [0x00, 0x50]
		var destinationPort: byte[2] = [0xC0, 0x81]
		var sequence: byte[4] = [0x80, 0x12, 0x34, 0xFF]
		var acknowledgment: byte[4] = [0xFE, 0xDC, 0xBA, 0x98]
		var window: byte[2] = [0x81, 0x23]
		var identification: byte[2] = [0x00, 0x02]
		assert this.segment.TryPrepare(localIp, remoteIp, sourcePort, destinationPort, sequence, acknowledgment, 0x12, window) == PacketDataResult.Success
		assert this.packet.TryPrepare(localIp, remoteIp, identification) == PacketDataResult.Success
		assert this.frame.TryPrepare(localMac, remoteMac) == PacketDataResult.Success
		var expected: byte[60] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x28, 0x00, 0x02, 0x40, 0x00, 0x40, 0x06, 0xB5, 0xFE, 0xC0, 0xA8, 0x01, 0x80, 0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12, 0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23, 0x7A, 0x86, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		var value: byte = 0x00

		for (var i = 0; i < 60; i++) {
			assert this.frame.TryRead(i, value) == PacketDataResult.Success
			assert value == expected[i]
		}

		assert this.frame.TryRead(-1, value) == PacketDataResult.Invalid
		assert this.frame.TryRead(60, value) == PacketDataResult.Invalid
	}
}
