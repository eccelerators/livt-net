namespace Livt.Net.Tests

using Livt.Net

@Test
component ArpCompositionChecks<CAPACITY: int>
{
	responder: ArpResponder<CAPACITY>
	new() { responder = new ArpResponder<CAPACITY>() }

	public fn Check()
	{
		var request: byte[CAPACITY]
		for (var i = 0; i < CAPACITY; i++) { request[i] = 0xFF }
		var localMac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteMac: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		for (var i = 0; i < 6; i++) { request[22 + i] = remoteMac[i] }
		for (var i = 0; i < 4; i++) { request[28 + i] = remoteIp[i] }
		// Complete reply including zero padding through byte 59.
		var expected: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC,
			0xDD, 0xEE, 0x08, 0x06, 0x00, 0x01, 0x08, 0x00, 0x06, 0x04,
			0x00, 0x02, 0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xC0, 0xA8,
			0x01, 0x80, 0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0xC0, 0xA8,
			0x01, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
			0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		for (var i = 0; i < 60; i++) {
			assert responder.GetReplyByte(request, i, localMac, localIp) == expected[i]
		}
		assert responder.GetReplyByte(request, -1, localMac, localIp) == 0x00
		assert responder.GetReplyByte(request, 60, localMac, localIp) == 0x00
		assert responder.GetReplyByte(request, CAPACITY + 60, localMac, localIp) == 0x00
	}
}

@Test
component SynAckCompositionChecks<CAPACITY: int>
{
	responder: TcpSynAckFrameComposer<CAPACITY>
	new() { responder = new TcpSynAckFrameComposer<CAPACITY>() }

	public fn Check()
	{
		var request: byte[CAPACITY]
		for (var i = 0; i < CAPACITY; i++) { request[i] = 0xFF }
		var localMac: byte[6] = [0x02, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE]
		var localIp: byte[4] = [0xC0, 0xA8, 0x01, 0x80]
		var remoteMac: byte[6] = [0x82, 0x10, 0x20, 0x30, 0x40, 0xFE]
		var remoteIp: byte[4] = [0xC0, 0xA8, 0x01, 0xFF]
		for (var i = 0; i < 6; i++) { request[6 + i] = remoteMac[i] }
		for (var i = 0; i < 4; i++) { request[26 + i] = remoteIp[i] }
		request[34] = 0xC0
		request[35] = 0x81
		request[36] = 0x00
		request[37] = 0x50
		// Distinct supplied checksum bytes verify placement, not calculation.
		var ipChecksum: byte[2] = [0xAB, 0xCD]
		var sequence: byte[4] = [0x80, 0x12, 0x34, 0xFF]
		var acknowledgment: byte[4] = [0xFE, 0xDC, 0xBA, 0x98]
		var window: byte[2] = [0x81, 0x23]
		var tcpChecksum: byte[2] = [0xEF, 0x90]
		// Complete reply including zero padding through byte 59.
		var expected: byte[60] = [
			0x82, 0x10, 0x20, 0x30, 0x40, 0xFE, 0x02, 0xAA, 0xBB, 0xCC,
			0xDD, 0xEE, 0x08, 0x00, 0x45, 0x00, 0x00, 0x28, 0x00, 0x02,
			0x40, 0x00, 0x40, 0x06, 0xAB, 0xCD, 0xC0, 0xA8, 0x01, 0x80,
			0xC0, 0xA8, 0x01, 0xFF, 0x00, 0x50, 0xC0, 0x81, 0x80, 0x12,
			0x34, 0xFF, 0xFE, 0xDC, 0xBA, 0x98, 0x50, 0x12, 0x81, 0x23,
			0xEF, 0x90, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
		for (var i = 0; i < 60; i++) {
			assert responder.GetFrameByte(request, i, localMac, localIp, ipChecksum, sequence, acknowledgment, window, tcpChecksum) == expected[i]
		}
		assert responder.GetFrameByte(request, -1, localMac, localIp, ipChecksum, sequence, acknowledgment, window, tcpChecksum) == 0x00
		assert responder.GetFrameByte(request, 60, localMac, localIp, ipChecksum, sequence, acknowledgment, window, tcpChecksum) == 0x00
		assert responder.GetFrameByte(request, CAPACITY + 60, localMac, localIp, ipChecksum, sequence, acknowledgment, window, tcpChecksum) == 0x00
	}
}

@Test
component FrameCompositionTest
{
	arpMinimum: ArpCompositionChecks<42>
	arpDefault: ArpCompositionChecks<64>
	arpLarge: ArpCompositionChecks<256>
	synMinimum: SynAckCompositionChecks<54>
	synDefault: SynAckCompositionChecks<128>
	synLarge: SynAckCompositionChecks<256>
	new()
	{
		arpMinimum = new ArpCompositionChecks<42>()
		arpDefault = new ArpCompositionChecks<64>()
		arpLarge = new ArpCompositionChecks<256>()
		synMinimum = new SynAckCompositionChecks<54>()
		synDefault = new SynAckCompositionChecks<128>()
		synLarge = new SynAckCompositionChecks<256>()
	}
	@Test
	fn ArpMinimumCapacity() { arpMinimum.Check() }
	@Test
	fn ArpDefaultCapacity() { arpDefault.Check() }
	@Test
	fn ArpLargeCapacity() { arpLarge.Check() }
	@Test
	fn SynMinimumCapacity() { synMinimum.Check() }
	@Test
	fn SynDefaultCapacity() { synDefault.Check() }
	@Test
	fn SynLargeCapacity() { synLarge.Check() }
}
