namespace Livt.Net.Tests

using Livt.Net

/**
 * Checks full ARP and SYN-ACK frames at minimum, default and larger capacities.
 */
@Test
component FrameCompositionTest
{
	arpMinimum: ArpCompositionChecks<42>
	arpDefault: ArpCompositionChecks<64>
	arpLarge: ArpCompositionChecks<256>
	synMinimum: SynAckCompositionChecks<54>
	synDefault: SynAckCompositionChecks<128>
	synLarge: SynAckCompositionChecks<256>

	/**
	 * Constructs separate ARP and SYN-ACK fixtures for minimum, default and larger capacities.
	 */
	new()
	{
		arpMinimum = new ArpCompositionChecks<42>()
		arpDefault = new ArpCompositionChecks<64>()
		arpLarge = new ArpCompositionChecks<256>()
		synMinimum = new SynAckCompositionChecks<54>()
		synDefault = new SynAckCompositionChecks<128>()
		synLarge = new SynAckCompositionChecks<256>()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn ArpMinimumCapacity()
	{
		arpMinimum.Check()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn ArpDefaultCapacity()
	{
		arpDefault.Check()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn ArpLargeCapacity()
	{
		arpLarge.Check()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn SynMinimumCapacity()
	{
		synMinimum.Check()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn SynDefaultCapacity()
	{
		synDefault.Check()
	}

	/**
	 * Runs the complete-frame fixture at this capacity; all expected bytes include minimum padding.
	 */
	@Test
	fn SynLargeCapacity()
	{
		synLarge.Check()
	}
}
