namespace Livt.Net.Tests

using Livt.Net
using Livt.IO

/**
 * Runs the shared TCP protocol regressions with independently selected byte stores.
 */
@Test
@Context(ClockFrequency = 50MHz)
component TcpStreamServerMixedStorageTest
{
	// Owned protocol fixture; each scenario initializes its connection state.
	checks: TcpStreamServerStorageChecks<ArrayRam<byte, 8>, BlockRam<byte, 8>>

	/**
	 * Creates the protocol fixture in this context.
	 */
	new()
	{
		checks = new TcpStreamServerStorageChecks<ArrayRam<byte, 8>, BlockRam<byte, 8>>()
	}

	/**
	 * Verifies StreamRetransmissionAndClose against the selected storage backends.
	 */
	@Test
	fn StreamRetransmissionAndClose()
	{
		checks.StreamRetransmissionAndClose()
	}

	/**
	 * Verifies ResumesAfterLongIdle against the selected storage backends.
	 */
	@Test
	fn ResumesAfterLongIdle()
	{
		checks.ResumesAfterLongIdle()
	}

	/**
	 * Verifies AbandonsUnansweredHandshakeAfterRetryLimit against the selected storage backends.
	 */
	@Test
	fn AbandonsUnansweredHandshakeAfterRetryLimit()
	{
		checks.AbandonsUnansweredHandshakeAfterRetryLimit()
	}

	/**
	 * Verifies LostHandshakeAndDataTimeout against the selected storage backends.
	 */
	@Test
	fn LostHandshakeAndDataTimeout()
	{
		checks.LostHandshakeAndDataTimeout()
	}
}
