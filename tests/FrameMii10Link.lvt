namespace Livt.Net.Tests

using Livt.IO

/**
 * Always-ready 10 Mb/s full-duplex link for the frame fixture.
 */
component FrameMii10Link : IEthernetLinkStatus
{
	/**
	 * Publishes the resolved full-duplex test link.
	 */
	process Status[]()
	{
		this.ready = true
		this.speed = EthernetSpeed.Mbps10
	}
}
