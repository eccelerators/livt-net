namespace Livt.Net.Tests

using Livt.Net
using Livt.IO

/**
 * Runs the shared TCP protocol regressions with independently selected byte stores.
 */
@Test
@Context(ClockFrequency = 50MHz)
component TcpMultiSessionDistributedStorageTest
{
	// Owned protocol fixture; each scenario initializes its connection state.
	checks: TcpMultiSessionStorageChecks<Ram<byte, 16, MemoryStyle.Distributed>, Ram<byte, 16, MemoryStyle.Distributed>>

	/**
	 * Creates the protocol fixture in this context.
	 */
	new()
	{
		checks = new TcpMultiSessionStorageChecks<Ram<byte, 16, MemoryStyle.Distributed>, Ram<byte, 16, MemoryStyle.Distributed>>()
	}

	/**
	 * Verifies IsolatesPeersAndReusesClosedSlot against the selected storage backends.
	 */
	@Test
	fn IsolatesPeersAndReusesClosedSlot()
	{
		checks.IsolatesPeersAndReusesClosedSlot()
	}

	/**
	 * Verifies ring wraparound, capacity and abort with the selected stores.
	 */
	@Test
	fn WrapsReceiveRingAndRejectsOverflow()
	{
		checks.WrapsReceiveRingAndRejectsOverflow()
	}
}
