namespace Livt.Net.Tests

using Livt.Net

/**
 * Exercises a shared TCP server with independent connection and retransmission scenarios.
 */
@Test
@Context(ClockFrequency = 50MHz)
component TcpStreamServerTest
{
	// Owned source, parsers and server reused with explicit scenario initialization.
	data: ArrayPacketData<64>
	ethernet: EthernetFrameParser<ArrayPacketData<64>>
	ipv4: Ipv4PacketParser<EthernetFrameParser<ArrayPacketData<64>>>
	server: TcpStreamServer<ArrayPacketData<64>, 23, 8, 8>

	// Fixture ACK adjustment for the current connection generation.
	acknowledgmentOffset: uint

	/**
	 * Constructs an isolated packet source, shared parsers and small RAM-backed TCP server.
	 */
	new()
	{
		this.data = new ArrayPacketData<64>()
		this.ethernet = new EthernetFrameParser<ArrayPacketData<64>>(this.data)
		this.ipv4 = new Ipv4PacketParser<EthernetFrameParser<ArrayPacketData<64>>>(this.ethernet)
		this.server = new TcpStreamServer<ArrayPacketData<64>, 23, 8, 8>(this.ethernet, this.ipv4, [2, 0, 0, 0, 0, 2], [10, 0, 0, 1])
	}

	/**
	 * Returns an independently checksummed wire fixture byte; unspecified padding is zero. Offsets
	 * 0..13 are Ethernet, 14..33 IPv4, and 34 onward TCP header/options/payload.
