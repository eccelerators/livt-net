namespace Livt.Net.Tests

using Livt.Net

/**
 * A minimal custom protocol handler used to verify dispatch priority.
 */
component FixedService<V: int> : IResponseService
{
	ready: bool
	disabled: bool
	calls: int

	/**
	 * Selects this handler until explicitly disabled by the test owner.
	 */
	override fn TryHandle() ServiceResult
	{
		if (this.ready) {
			return ServiceResult.Busy
		}

		this.calls++

		if (this.disabled) {
			return ServiceResult.Ignored
		}

		this.ready = true
		return ServiceResult.Prepared
	}

	/**
	 * Ends the selected response publication.
	 */
	override fn TryReleaseResponse() PacketDataResult
	{
		if (!this.ready) {
			return PacketDataResult.Invalid
		}

		this.ready = false
		return PacketDataResult.Success
	}

	/**
	 * Reports whether this handler has prepared its response.
	 */
	override fn IsReady() bool
	{
		return this.ready
	}

	/**
	 * Returns the single test byte only while published.
	 */
	override fn GetAvailableLength() int
	{
		if (this.ready) {
			return 1
		}

		return 0
	}

	/**
	 * Reads the distinguishing byte without changing publication.
	 */
	override fn TryRead(index: int, value: out byte) PacketDataResult
	{
		value = 0x00

		if (!this.ready) {
			return PacketDataResult.NotReady
		}

		if (index != 0) {
			return PacketDataResult.Invalid
		}

		value = V as byte
		return PacketDataResult.Success
	}

	/**
	 * Changes request acceptance between response lifecycles.
	 */
	public fn Disable()
	{
		this.disabled = true
	}

	/**
	 * Counts dispatch attempts to detect unexpected fallthrough.
	 */
	public fn GetCalls() int
	{
		return this.calls
	}
}

/**
 * Proves that overlapping custom handlers have deterministic priority.
 */
@Test
component ServiceChainTest
{
	first: FixedService<17>
	second: FixedService<34>
	chain: ServiceChain<FixedService<17>, FixedService<34>>

	/**
	 * Creates two eligible handlers in an explicit priority order.
	 */
	new()
	{
		this.first = new FixedService<17>()
		this.second = new FixedService<34>()
		this.chain = new ServiceChain<FixedService<17>, FixedService<34>>(this.first, this.second)
	}

	/**
	 * Holds the first choice and falls through only after an ignored request.
	 */
	@Test
	fn PreservesPriorityAndSelectedResponse()
	{
		assert this.chain.TryHandle() == ServiceResult.Prepared
		assert this.chain.GetSelection() == ServiceSelection.First
		assert this.first.GetCalls() == 1
		assert this.second.GetCalls() == 0
		assert this.chain.TryHandle() == ServiceResult.Busy
		var value: byte = 0x00
		assert this.chain.TryRead(0, value) == PacketDataResult.Success
		assert value == 0x11
		assert this.chain.TryReleaseResponse() == PacketDataResult.Success
		this.first.Disable()
		assert this.chain.TryHandle() == ServiceResult.Prepared
		assert this.chain.GetSelection() == ServiceSelection.Second
		assert this.first.GetCalls() == 2
		assert this.second.GetCalls() == 1
		assert this.chain.TryRead(0, value) == PacketDataResult.Success
		assert value == 0x22
		assert this.chain.TryReleaseResponse() == PacketDataResult.Success
		assert !this.chain.IsReady()
		assert this.chain.TryRead(0, value) == PacketDataResult.NotReady
		assert value == 0x00
	}
}
